---
import TaxCalculator from '../../components/calculator/TaxCalculator';
import CalculatorNextStep from '../../components/calculator-next-step.astro';
import SiteLayout from '../../layouts/site-layout.astro';
import {
  getPublishedStatePages,
  getStateName,
  getStateSlug,
} from '../../data/tax/calculator-pages';
import { getPublishedProfessionPages } from '../../data/tax/profession-pages';
import { getProfessionPreset } from '../../data/tax/profession-presets';

const title = 'Self-Employment Tax Calculator 2026 | Free 1099 Tax Estimator';
const description =
  'Free self-employment tax calculator for freelancers, contractors, and gig workers. Estimate federal, state, and SE tax owed for 2026. Updated with latest IRS rules.';
const canonical = 'https://llcatlas.com/self-employment-tax/calculator/';
const lastReviewed = '2026-05-07';
const lastReviewedLabel = 'May 7, 2026';
const statePages = getPublishedStatePages();
const professionPages = getPublishedProfessionPages();

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Self-Employment Tax Calculator 2026',
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    url: canonical,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    datePublished: '2026-05-07',
    dateModified: lastReviewed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Who needs to pay self-employment tax?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Anyone earning $400 or more in net self-employment income - freelancers, gig workers (Uber, DoorDash, Lyft), independent contractors, single-member LLC owners, sole proprietors, and most consultants.',
        },
      },
      {
        '@type': 'Question',
        name: 'When are quarterly tax payments due?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'For tax year 2026, the IRS deadlines are April 15, June 15, September 15 (all 2026), and January 15, 2027. Missing these can trigger underpayment penalties.',
        },
      },
      {
        '@type': 'Question',
        name: 'How accurate is this calculator?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "The calculator uses 2026 federal tax brackets (per IRS Rev. Proc. 2025-32) and 2025 state tax brackets (per Tax Foundation). It computes SE tax, federal income tax with standard deduction, and state income tax using each state's bracket structure. For your exact situation, consult a CPA.",
        },
      },
      {
        '@type': 'Question',
        name: 'Should I form an LLC or S-Corp to save on taxes?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'For freelancers earning under ~$80K, an LLC taxed as a sole proprietor (the default) is usually fine. Above that, electing S-Corp tax treatment can reduce SE tax by paying yourself a reasonable salary and taking the rest as distributions.',
        },
      },
    ],
  },
];
---

<SiteLayout title={title} description={description} structuredData={structuredData}>
  <article class="mx-auto max-w-6xl px-4 py-8 lg:py-12">
    <header class="mb-8">
      <h1 class="mb-3 text-3xl font-bold text-slate-900 lg:text-4xl">
        Self-Employment Tax Calculator 2026
      </h1>
      <p class="text-lg leading-relaxed text-slate-600">
        Estimate your federal, state, and self-employment tax in seconds. Built for freelancers,
        independent contractors, and gig workers. Updated with 2026 federal and 2025 state tax rules.
      </p>
    </header>

    <section class="mb-12" aria-label="Tax calculator">
      <TaxCalculator client:load />
    </section>

    <CalculatorNextStep />

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">How self-employment tax works</h2>
      <p class="mb-4 leading-relaxed text-slate-700">
        If you're self-employed and earn $400 or more in net income, you owe self-employment tax in
        addition to federal and state income tax. SE tax covers Social Security (12.4%) and Medicare
        (2.9%) - what an employer would normally split with you. Total: <strong>15.3%</strong> of
        your net earnings (after a 7.65% deduction).
      </p>
      <p class="mb-4 leading-relaxed text-slate-700">
        On top of SE tax, you also owe federal income tax based on your tax bracket and state income
        tax (in 41 of 50 states). Most self-employed filers should set aside <strong>25-35%</strong>
        of their gross income for taxes, depending on income level and state.
      </p>
      <p class="leading-relaxed text-slate-700">
        If this calculator shows steady profit around $60K or more, run the{' '}
        <a
          href="/s-corp/election-calculator/"
          class="font-semibold text-ink-strong underline decoration-rule-strong underline-offset-4 transition hover:text-ink-soft hover:decoration-ink-muted"
        >
          S-corp election calculator
        </a>{' '}
        next. S-corp treatment only helps when the tax savings beat payroll, accounting, and state
        admin costs.
      </p>
    </section>

    <section class="mb-12 grid gap-6 md:grid-cols-3">
      <div class="llc-card">
        <h3 class="mb-2 font-semibold text-slate-900">SE tax (15.3%)</h3>
        <p class="text-sm leading-relaxed text-slate-600">
          Social Security (12.4% up to $184,500 in 2026) + Medicare (2.9%, no cap). You can deduct
          half of SE tax from your federal taxable income.
        </p>
      </div>
      <div class="llc-card">
        <h3 class="mb-2 font-semibold text-slate-900">Federal income tax</h3>
        <p class="text-sm leading-relaxed text-slate-600">
          7 brackets from 10% to 37% in 2026. After standard deduction ($16,100 single, $32,200
          married filing jointly).
        </p>
      </div>
      <div class="llc-card">
        <h3 class="mb-2 font-semibold text-slate-900">State income tax</h3>
        <p class="text-sm leading-relaxed text-slate-600">
          Varies dramatically: 0% in 9 states (TX, FL, etc.), flat rates in 12 states, graduated
          brackets up to 13.3% in California.
        </p>
      </div>
    </section>

    <section class="mb-12 rounded-[1.5rem] border border-rule bg-surface-subtle p-6 sm:p-8">
      <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
        <div class="space-y-3">
          <p class="llc-helper">Next calculator</p>
          <h2 class="text-2xl">Could S-corp treatment lower this number?</h2>
          <p class="max-w-2xl text-[15px] leading-7 text-ink-soft">
            The answer depends on reasonable salary, payroll fees, accounting costs, and state
            annual costs. Check the net savings before you file Form 2553.
          </p>
        </div>
        <a
          href="/s-corp/election-calculator/"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-accent px-5 py-3 text-sm font-semibold text-ink-strong transition hover:bg-accent/85"
        >
          Run S-corp calculator
        </a>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">State-specific calculators</h2>
      <p class="mb-4 leading-relaxed text-slate-700">
        Choose your state for a calculator pre-configured with that state's specific tax structure:
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          statePages.map((page) => (
            <a
              href={`/self-employment-tax/${getStateSlug(page.state)}/`}
              class="llc-card transition-colors hover:border-blue-400"
            >
              <span class="font-medium text-slate-900">{getStateName(page.state)}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">By profession</h2>
      <p class="mb-4 leading-relaxed text-slate-700">
        Profession-specific calculators with deduction guidance for common gig economy and freelance
        work:
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          professionPages.map((page) => {
            const preset = getProfessionPreset(page.profession);

            return (
              <a
                href={`/self-employment-tax/1099/${page.profession}/`}
                class="llc-card transition-colors hover:border-blue-400"
              >
                <span class="font-medium text-slate-900">
                  {preset.displayName} tax calculator
                </span>
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-6 text-2xl font-bold text-slate-900">Common questions</h2>
      <div class="space-y-6">
        <div>
          <h3 class="mb-2 font-semibold text-slate-900">Who needs to pay self-employment tax?</h3>
          <p class="leading-relaxed text-slate-700">
            Anyone earning $400 or more in net self-employment income - freelancers, gig workers
            (Uber, DoorDash, Lyft), independent contractors, single-member LLC owners, sole
            proprietors, and most consultants.
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold text-slate-900">When are quarterly tax payments due?</h3>
          <p class="leading-relaxed text-slate-700">
            For tax year 2026, the IRS deadlines are April 15, June 15, September 15 (all 2026), and
            January 15, 2027. Missing these can trigger underpayment penalties.
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold text-slate-900">How accurate is this calculator?</h3>
          <p class="leading-relaxed text-slate-700">
            The calculator uses 2026 federal tax brackets (per IRS Rev. Proc. 2025-32) and 2025
            state tax brackets (per Tax Foundation). It computes SE tax, federal income tax with
            standard deduction, and state income tax using each state's bracket structure. It does
            not model business deductions beyond a generic net-income input, and it simplifies
            state-specific adjustments. For your exact situation, consult a CPA.
          </p>
        </div>
        <div>
          <h3 class="mb-2 font-semibold text-slate-900">
            Should I form an LLC or S-Corp to save on taxes?
          </h3>
          <p class="leading-relaxed text-slate-700">
            For freelancers earning under ~$80K, an LLC taxed as a sole proprietor (the default) is
            usually fine. Above that, electing S-Corp tax treatment can reduce SE tax by paying
            yourself a "reasonable salary" and taking the rest as distributions. Use the{' '}
            <a
              href="/s-corp/election-calculator/"
              class="font-semibold text-ink-strong underline decoration-rule-strong underline-offset-4 transition hover:text-ink-soft hover:decoration-ink-muted"
            >
              S-corp election calculator
            </a>{' '}
            to see whether the savings beat the extra costs.
          </p>
        </div>
      </div>
    </section>

    <footer class="mt-12 border-t border-slate-200 pt-6">
      <p class="text-xs text-slate-500">
        Last reviewed: {lastReviewedLabel}. Sources:
        <a
          href="https://www.irs.gov/pub/irs-drop/rp-25-32.pdf"
          class="llc-link"
          rel="external">IRS Rev. Proc. 2025-32</a
        >,
        <a
          href="https://www.ssa.gov/news/press/factsheets/colafacts2026.pdf"
          class="llc-link"
          rel="external">SSA 2026 COLA fact sheet</a
        >,
        <a
          href="https://taxfoundation.org/data/all/state/state-income-tax-rates/"
          class="llc-link"
          rel="external">Tax Foundation 2025 state data</a
        >.
      </p>
    </footer>
  </article>
</SiteLayout>
