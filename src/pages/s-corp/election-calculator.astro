---
import SCorpElectionCalculator from '../../components/calculator/SCorpElectionCalculator';
import CalculatorAssumptions from '../../components/calculator/CalculatorAssumptions.astro';
import CalculatorCta from '../../components/calculator/CalculatorCta.astro';
import CalculatorFaq from '../../components/calculator/CalculatorFaq.astro';
import CalculatorHero from '../../components/calculator/CalculatorHero.astro';
import CalculatorRelatedLinks from '../../components/calculator/CalculatorRelatedLinks.astro';
import SiteLayout from '../../layouts/site-layout.astro';

const title = 'S-Corp Tax Savings Calculator 2026 | LLCAtlas';
const description =
  'Free S-corp election calculator for LLC owners and freelancers. Estimate SE tax savings, payroll costs, accounting costs, and whether S-corp treatment is worth it.';
const canonical = 'https://llcatlas.com/s-corp/election-calculator/';
const lastReviewed = '2026-05-22';
const lastReviewedLabel = 'May 22, 2026';
const faqItems = [
  {
    question: 'When is an S-corp election worth it?',
    answer:
      'For many solo owners, S-corp treatment starts to become worth discussing around $60,000 or more in consistent net business income. Below that, payroll, accounting, state fees, and extra compliance often consume the savings.',
  },
  {
    question: 'What is reasonable compensation?',
    answer:
      'Reasonable compensation is the salary an S-corp owner pays themselves for the work they perform. It should reflect the role, hours, market pay, and business facts. Paying yourself an artificially low salary is a tax-risk problem, not a savings strategy.',
  },
  {
    question: 'Does this calculator include income tax?',
    answer:
      'No. It focuses on the core S-corp decision: self-employment tax versus payroll tax, then subtracts added admin costs. Federal and state income tax can still matter, especially with QBI and state entity rules, so use this as a screening tool rather than tax advice.',
  },
  {
    question: 'Do I need an LLC before electing S-corp status?',
    answer:
      'Most solo founders form an LLC first, then file IRS Form 2553 to elect S-corp tax treatment. The LLC is the legal entity; S-corp is a federal tax classification.',
  },
];
const assumptionColumns = [
  {
    title: 'What is included',
    items: [
      'Current sole proprietor or default LLC self-employment tax.',
      'S-corp payroll tax on the salary assumption.',
      'Payroll provider, accounting, and available state annual fee estimates.',
      'A recommendation tier based on both income and net savings after costs.',
    ],
  },
  {
    title: 'What is not included',
    items: [
      'Local taxes, QBI deduction effects, or owner-specific income-tax planning.',
      'State entity-level taxes that are not yet structured in LLCAtlas data.',
      'Penalty risk from paying yourself an unreasonable salary.',
      'Legal or tax advice. Use this as a screening tool before hiring a CPA.',
    ],
  },
];
const relatedLinks = [
  {
    href: '/self-employment-tax/calculator/',
    title: 'Self-employment tax calculator',
    description: 'See the baseline tax first.',
  },
  {
    href: '/llc-vs-s-corp/',
    title: 'LLC vs S-corp',
    description: 'Understand the entity choice.',
  },
  {
    href: '/s-corp/reasonable-compensation/',
    title: 'Reasonable compensation',
    description: 'Pressure-test the salary number.',
  },
  {
    href: '/best-llc-services/',
    title: 'Best LLC services',
    description: 'Compare help before paying.',
  },
  {
    href: '/northwest-vs-bizee/',
    title: 'Northwest vs Bizee',
    description: 'Pick formation help without upsells.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'S-Corp Election Savings Calculator',
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    url: canonical,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    datePublished: lastReviewed,
    dateModified: lastReviewed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://llcatlas.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'S-corp election calculator',
        item: canonical,
      },
    ],
  },
];
---

<SiteLayout title={title} description={description} structuredData={structuredData}>
  <article class="mx-auto max-w-6xl px-4 py-8 lg:py-12">
    <CalculatorHero
      eyebrow="S-corp election calculator"
      title="S-corp tax savings calculator"
      description="Estimate whether electing S-corp tax treatment is actually worth it after payroll, accounting, and state costs. The point is not to make the savings look big. The point is to find the income level where the hassle starts to make sense."
      lastReviewed={lastReviewed}
      lastReviewedLabel={lastReviewedLabel}
    />

    <section class="mb-12" aria-label="S-corp savings calculator">
      <SCorpElectionCalculator client:load />
    </section>

    <section class="mb-12 grid gap-5 md:grid-cols-3">
      <div class="llc-card">
        <p class="llc-helper">Bad deal</p>
        <h2 class="mt-2 text-xl">Usually under $45K</h2>
        <p class="mt-2 text-[15px] leading-7 text-ink-soft">
          At low income, the S-corp paperwork stack can cost as much as the tax you are trying to
          save. Keep it simple unless there is a non-tax reason to switch.
        </p>
      </div>
      <div class="llc-card">
        <p class="llc-helper">Borderline</p>
        <h2 class="mt-2 text-xl">$45K to $60K</h2>
        <p class="mt-2 text-[15px] leading-7 text-ink-soft">
          This is where headline savings can look tempting but payroll fees, CPA time, and state
          rules often decide the real answer.
        </p>
      </div>
      <div class="llc-card-highlight">
        <p class="llc-helper">Worth a CPA conversation</p>
        <h2 class="mt-2 text-xl">$60K+ and consistent</h2>
        <p class="mt-2 text-[15px] leading-7 text-ink-soft">
          If the income is stable and the net savings clear the admin costs, S-corp treatment can
          become worth planning around.
        </p>
      </div>
    </section>

    <CalculatorAssumptions
      title="What this calculator assumes"
      description="The calculator compares regular self-employment tax against S-corp payroll tax on a reasonable salary. It then subtracts estimated payroll, accounting, and state admin costs. Defaults are intentionally conservative: 50% salary, $1,200 payroll, and $1,300 added accounting cost."
      columns={assumptionColumns}
    />

    <CalculatorCta
      eyebrow="Next step"
      title="Do not elect S-corp treatment just because the gross savings look good."
      description="If the calculator says it is worth considering, compare formation help before you add S-corp paperwork. If it says borderline, start with the self-employment tax math and reasonable salary basics first."
      primary={{ href: '/best-llc-services/', label: 'Compare LLC services' }}
      secondary={{ href: '/llc-vs-s-corp/', label: 'Read LLC vs S-corp' }}
    />

    <CalculatorRelatedLinks links={relatedLinks} />

    <CalculatorFaq
      items={faqItems}
      intro="The questions that matter before you pay for payroll or ask a CPA to file Form 2553."
    />
  </article>
</SiteLayout>
