---
import { getPublishedProfessionPages } from '../../../data/tax/profession-pages';

export function getStaticPaths() {
  return getPublishedProfessionPages().map((page) => ({
    params: { profession: page.profession },
  }));
}

const targetPath = `/self-employment-tax/1099/${Astro.params.profession}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${targetPath}`} />
    <link rel="canonical" href={`https://llcatlas.com${targetPath}`} />
    <title>Redirecting to 1099 tax calculator | LLCAtlas</title>
  </head>
  <body>
    <p><a href={targetPath}>Continue to the 1099 tax calculator.</a></p>
  </body>
</html>