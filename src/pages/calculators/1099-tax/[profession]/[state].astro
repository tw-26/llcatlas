---
import TaxCalculator from '../../../../components/calculator/TaxCalculator';
import SiteLayout from '../../../../layouts/site-layout.astro';
import {
  getComboKeyword,
  getComboMetaDescription,
  getPublishedComboPages,
  getSiblingsByProfession,
  getSiblingsByState,
  type ComboPage,
} from '../../../../data/tax/combo-pages';
import { getStateName, getStateSlug } from '../../../../data/tax/calculator-pages';
import { getProfessionPreset } from '../../../../data/tax/profession-presets';
import { STATE_RULES_2025 } from '../../../../data/tax/state-rules-2025';

export async function getStaticPaths() {
  return getPublishedComboPages().map((combo) => ({
    params: {
      profession: combo.profession,
      state: getStateSlug(combo.state),
    },
    props: { combo },
  }));
}

interface Props {
  combo: ComboPage;
}

const { combo } = Astro.props as Props;
const preset = getProfessionPreset(combo.profession);
const stateName = getStateName(combo.state);
const stateSlug = getStateSlug(combo.state);
const stateRules = STATE_RULES_2025[combo.state];

const keyword = getComboKeyword(combo.profession, combo.state);
const title = `${keyword} 2026 | Free SE Tax Estimator`;
const description = getComboMetaDescription(combo.profession, combo.state);
const canonical = `https://llcatlas.com/calculators/1099-tax/${combo.profession}/${stateSlug}/`;
const lastReviewed = '2026-05-13';
const lastReviewedLabel = 'May 13, 2026';

const otherStatesForThisProfession = getSiblingsByProfession(combo.profession, combo.state);
const otherProfessionsForThisState = getSiblingsByState(combo.state, combo.profession);

const stateTaxSummary = (() => {
  if (!stateRules.hasIncomeTax) {
    return `${stateName} has no state individual income tax - you only owe federal income tax and 15.3% self-employment tax.`;
  }

  if (stateRules.taxStructure === 'flat' && stateRules.flatRate !== undefined) {
    return `${stateName} has a flat ${(stateRules.flatRate * 100).toFixed(2)}% state income tax on top of federal and SE tax.`;
  }

  const brackets = stateRules.brackets?.single ?? [];
  const topRate = brackets.length > 0 ? brackets[brackets.length - 1].rate : 0;

  return `${stateName} has graduated income tax brackets with a top rate of ${(topRate * 100).toFixed(2)}% on top of federal and SE tax.`;
})();

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${keyword} 2026`,
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    url: canonical,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    datePublished: '2026-05-13',
    dateModified: lastReviewed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://llcatlas.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Self-employment tax calculator',
        item: 'https://llcatlas.com/calculators/self-employment-tax/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: `${preset.displayName} tax calculator`,
        item: `https://llcatlas.com/calculators/1099-tax/${combo.profession}/`,
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: `${keyword} 2026`,
        item: canonical,
      },
    ],
  },
];
---

<SiteLayout title={title} description={description} structuredData={structuredData}>
  <article class="mx-auto max-w-6xl px-4 py-8 lg:py-12">
    <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
      <a href="/" class="llc-link">Home</a>
      <span class="mx-2">/</span>
      <a href="/calculators/self-employment-tax/" class="llc-link">SE Tax Calculator</a>
      <span class="mx-2">/</span>
      <a href={`/calculators/1099-tax/${combo.profession}/`} class="llc-link">
        {preset.displayName}
      </a>
      <span class="mx-2">/</span>
      <span class="text-slate-700">{stateName}</span>
    </nav>

    <header class="mb-8">
      <h1 class="mb-3 text-3xl font-bold text-slate-900 lg:text-4xl">{keyword} 2026</h1>
      <p class="text-lg leading-relaxed text-slate-600">
        Estimate the federal, state, and self-employment tax you owe as a {
          preset.displayName.toLowerCase()
        } in {stateName}. {stateTaxSummary}
      </p>
    </header>

    <section class="mb-6">
      <div class="llc-card-highlight">
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-900">
          Before you start
        </h2>
        <p class="leading-relaxed text-slate-700">{preset.incomeNote}</p>
      </div>
    </section>

    <section class="mb-12" aria-label="Tax calculator">
      <TaxCalculator client:load defaultState={combo.state} lockState={true} />
    </section>

    <section class="mb-12">
      <div class="llc-card">
        <h2 class="mb-3 text-xl font-semibold text-slate-900">
          How {stateName} taxes {preset.displayName.toLowerCase()} earnings
        </h2>
        <p class="leading-relaxed text-slate-700">{stateTaxSummary}</p>
        {
          stateRules.notes && (
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{stateRules.notes}</p>
          )
        }
      </div>
    </section>

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">
        Common {preset.displayName.toLowerCase()} tax deductions
      </h2>
      <p class="mb-4 leading-relaxed text-slate-700">
        Subtract these business expenses from your gross 1099 earnings before entering income above.
        The calculator expects NET self-employment income.
      </p>
      <ul class="space-y-2 text-slate-700">
        {
          preset.commonDeductions.map((deduction) => (
            <li class="flex gap-2">
              <span class="mt-1 text-slate-400">-</span>
              <span class="leading-relaxed">{deduction}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      otherStatesForThisProfession.length > 0 && (
        <section class="mb-12">
          <h2 class="mb-4 text-2xl font-bold text-slate-900">
            {preset.displayName} tax calculator for other states
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {otherStatesForThisProfession.map((state) => (
              <a
                href={`/calculators/1099-tax/${combo.profession}/${state.stateSlug}/`}
                class="llc-card transition-colors hover:border-blue-400"
              >
                <span class="font-medium text-slate-900">{state.stateName}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      otherProfessionsForThisState.length > 0 && (
        <section class="mb-12">
          <h2 class="mb-4 text-2xl font-bold text-slate-900">
            Other 1099 professions in {stateName}
          </h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {otherProfessionsForThisState.map((profession) => (
              <a
                href={`/calculators/1099-tax/${profession.profession}/${stateSlug}/`}
                class="llc-card transition-colors hover:border-blue-400"
              >
                <span class="font-medium text-slate-900">
                  {profession.label} tax calculator
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="mb-12">
      <h2 class="mb-4 text-2xl font-bold text-slate-900">Related calculators</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <a
          href={`/calculators/1099-tax/${combo.profession}/`}
          class="llc-card transition-colors hover:border-blue-400"
        >
          <span class="font-medium text-slate-900">
            {preset.displayName} tax calculator (all states)
          </span>
        </a>
        <a
          href={`/calculators/self-employment-tax/${stateSlug}/`}
          class="llc-card transition-colors hover:border-blue-400"
        >
          <span class="font-medium text-slate-900">
            {stateName} SE tax calculator (all professions)
          </span>
        </a>
      </div>
    </section>

    <footer class="mt-12 border-t border-slate-200 pt-6">
      <p class="text-xs text-slate-500">
        Last reviewed: {lastReviewedLabel}. Sources:
        <a href="https://www.irs.gov/pub/irs-drop/rp-25-32.pdf" class="llc-link" rel="external">
          IRS Rev. Proc. 2025-32
        </a>,
        {
          stateRules.sources.map((source, index) => (
            <>
              <a href={source} class="llc-link" rel="external">
                {new URL(source).hostname.replace('www.', '')}
              </a>
              {index < stateRules.sources.length - 1 && ', '}
            </>
          ))
        }.
      </p>
    </footer>
  </article>
</SiteLayout>
