---
import { getPublishedComboPages } from '../../../../data/tax/combo-pages';
import { getStateSlug } from '../../../../data/tax/calculator-pages';

export function getStaticPaths() {
  return getPublishedComboPages().map((combo) => ({
    params: {
      profession: combo.profession,
      state: getStateSlug(combo.state),
    },
  }));
}

const targetPath = `/self-employment-tax/1099/${Astro.params.profession}/${Astro.params.state}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${targetPath}`} />
    <link rel="canonical" href={`https://llcatlas.com${targetPath}`} />
    <title>Redirecting to 1099 state tax calculator | LLCAtlas</title>
  </head>
  <body>
    <p><a href={targetPath}>Continue to the 1099 state tax calculator.</a></p>
  </body>
</html>