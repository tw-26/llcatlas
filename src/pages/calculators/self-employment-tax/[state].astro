---
import { getPublishedStatePages, getStateSlug } from '../../../data/tax/calculator-pages';

export function getStaticPaths() {
  return getPublishedStatePages().map((page) => ({
    params: { state: getStateSlug(page.state) },
  }));
}

const targetPath = `/self-employment-tax/${Astro.params.state}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${targetPath}`} />
    <link rel="canonical" href={`https://llcatlas.com${targetPath}`} />
    <title>Redirecting to state self-employment tax calculator | LLCAtlas</title>
  </head>
  <body>
    <p><a href={targetPath}>Continue to the state self-employment tax calculator.</a></p>
  </body>
</html>