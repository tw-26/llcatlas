---
import AffiliateLinkedText from '../components/affiliate-linked-text.astro';
import SiteLayout from '../layouts/site-layout.astro';

const title = 'Privacy Policy | LLCAtlas';
const description =
  'How LLCAtlas handles privacy, affiliate links, and site data. Short version: we measure traffic with Cloudflare and Google Analytics, and we never sell data or run ads.';
const pageUrl = 'https://llcatlas.com/privacy';
const lastUpdated = 'September 2026';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'en-US',
  },
];
---

<SiteLayout title={title} description={description} structuredData={structuredData}>
  <section class="space-y-4">
    <h1>Privacy</h1>
    <p class="text-lg leading-8 text-ink-soft">
      Last updated {lastUpdated}. This site measures traffic and affiliate clicks, but does not
      collect your name or contact details, sell data, or run ads.
    </p>
  </section>

  <section aria-labelledby="what-we-collect" class="max-w-3xl space-y-4">
    <h2 id="what-we-collect">What we collect</h2>
    <p class="text-lg leading-8 text-ink-soft">
      LLCAtlas uses Cloudflare Web Analytics to understand aggregate site usage: pages viewed,
      referrers, approximate geography, device type, and similar high-level metrics. Cloudflare Web
      Analytics does not use cookies.
    </p>
    <p class="text-lg leading-8 text-ink-soft">
      We also use Google Analytics to see which pages and calculators are useful and which partner
      links get clicked. Google Analytics sets cookies and records a random browser ID, pages
      viewed, and approximate location. We don't send it your name, email, or anything you type
      into a calculator, and we don't use it for advertising. We don't use session replay or
      ad-network pixels. You can opt out with Google's
      <a
        href="https://tools.google.com/dlpage/gaoptout"
        class="underline decoration-rule-strong underline-offset-4 transition hover:text-ink-strong"
        rel="noopener"
        target="_blank">browser add-on</a
      > or by blocking cookies for this site.
    </p>
    <p class="text-lg leading-8 text-ink-soft">
      Server logs may exist at the hosting layer for security and uptime, but LLCAtlas does not use
      them to profile visitors.
    </p>
  </section>

  <section aria-labelledby="how-we-earn" class="max-w-3xl space-y-4">
    <h2 id="how-we-earn">How this site makes money</h2>
    <p class="text-lg leading-8 text-ink-soft">
      <AffiliateLinkedText
        text="Some of the outbound links here are affiliate links. If you click one and sign up with a formation service like Northwest, Bizee, or ZenBusiness, we may earn a small commission. You pay the same price either way."
        placement="privacy-affiliate-disclosure"
      />
    </p>
    <p class="text-lg leading-8 text-ink-soft">
      The commission doesn't change which service we recommend. We recommend the cheapest good
      option first and the safest paid option second, and we say so whether anyone is paying us
      or not. If a service stops paying affiliates tomorrow, our recommendations wouldn't change.
    </p>
    <p class="text-lg leading-8 text-ink-soft">
      We don't run display ads. No banners, no pop-ups, no sponsored articles written to look
      like reviews.
    </p>
  </section>

  <section aria-labelledby="cookies" class="max-w-3xl space-y-4">
    <h2 id="cookies">Cookies</h2>
    <p class="text-lg leading-8 text-ink-soft">
      Google Analytics sets first-party cookies (named <code>_ga</code> and <code>_ga_*</code>) to
      tell new visits from returning ones. We don't set advertising cookies, and LLCAtlas itself
      doesn't set any other cookies.
    </p>
  </section>

  <section aria-labelledby="your-data" class="max-w-3xl space-y-4">
    <h2 id="your-data">Your data</h2>
    <p class="text-lg leading-8 text-ink-soft">
      We don't collect your name, email, or other contact details, and there are no accounts, so
      there is no LLCAtlas profile to export or delete. Analytics data is kept by Cloudflare and
      Google under their own retention settings.
    </p>
    <p class="text-lg leading-8 text-ink-soft">
      If that ever changes, for example if we add a newsletter or a login, we'll say so on this
      page before collecting anything.
    </p>
  </section>

  <section aria-labelledby="changes" class="max-w-3xl space-y-4">
    <h2 id="changes">Changes to this page</h2>
    <p class="text-lg leading-8 text-ink-soft">
      If we change what we collect, we'll update the date at the top and explain what changed.
      We won't bury anything.
    </p>
  </section>
</SiteLayout>
