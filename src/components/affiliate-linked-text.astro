---
import { affiliates, isAffiliateConfigured, type AffiliatePartner } from '../data/affiliates';
import { getAffiliatePageType } from '../lib/affiliate-tracking';

interface ProviderMatch {
  partner: AffiliatePartner;
  partnerName: string;
}

interface Props {
  text: string;
  placement: string;
  state?: string;
}

const { text, placement, state = 'national' } = Astro.props as Props;
const pageType = getAffiliatePageType(Astro.url.pathname);

const providerByName: Record<string, ProviderMatch> = {
  Bizee: {
    partner: 'bizee',
    partnerName: 'Bizee',
  },
  Northwest: {
    partner: 'northwest',
    partnerName: 'Northwest Registered Agent',
  },
  LegalZoom: {
    partner: 'legalzoom',
    partnerName: 'LegalZoom',
  },
  ZenBusiness: {
    partner: 'zenbusiness',
    partnerName: 'ZenBusiness',
  },
  ZoomBusiness: {
    partner: 'zenbusiness',
    partnerName: 'ZenBusiness',
  },
};

const providerPattern = /\b(Bizee|Northwest|LegalZoom|ZenBusiness|ZoomBusiness)\b/g;
const parts = text.split(providerPattern);
---

{
  parts.map((part) => {
    const provider = providerByName[part];

    if (!provider) {
      return part;
    }

    const isAffiliate = isAffiliateConfigured(provider.partner);

    return (
      <a
        href={affiliates[provider.partner]}
        target="_blank"
        rel={isAffiliate ? 'sponsored noopener' : 'noopener'}
        data-affiliate={isAffiliate ? provider.partner : undefined}
        data-page-type={isAffiliate ? pageType : undefined}
        data-position={isAffiliate ? placement : undefined}
        data-state={isAffiliate ? state : undefined}
        class="llc-link"
      >
        {part}
      </a>
    );
  })
}
