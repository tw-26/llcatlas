---
import { affiliates, type AffiliatePartner } from '../data/affiliates';
import { getAffiliateLinkAttributes } from '../lib/affiliate-links';
import { getAffiliatePageType } from '../lib/affiliate-tracking';

interface ProviderMatch {
  partner: AffiliatePartner;
  partnerName: string;
}

interface Props {
  text: string;
  placement: string;
  state?: string;
}

const { text, placement, state = 'national' } = Astro.props as Props;
const pageType = getAffiliatePageType(Astro.url.pathname);

const providerByName: Record<string, ProviderMatch> = {
  Bizee: {
    partner: 'bizee',
    partnerName: 'Bizee',
  },
  Northwest: {
    partner: 'northwest',
    partnerName: 'Northwest Registered Agent',
  },
  LegalZoom: {
    partner: 'legalzoom',
    partnerName: 'LegalZoom',
  },
  ZenBusiness: {
    partner: 'zenbusiness',
    partnerName: 'ZenBusiness',
  },
  ZoomBusiness: {
    partner: 'zenbusiness',
    partnerName: 'ZenBusiness',
  },
};

const providerPattern = /\b(Bizee|Northwest|LegalZoom|ZenBusiness|ZoomBusiness)\b/g;
const parts = text.split(providerPattern);
---

{
  parts.map((part) => {
    const provider = providerByName[part];

    if (!provider) {
      return part;
    }

    const affiliateAttributes = getAffiliateLinkAttributes({
      href: affiliates[provider.partner],
      partnerName: provider.partnerName,
      pageType,
      position: placement,
      state,
    });

    return (
      <a
        {...affiliateAttributes}
        class="llc-link"
      >
        {part}
      </a>
    );
  })
}
