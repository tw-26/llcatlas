---
export type CalculatorFaqItem = {
  question: string;
  answer: string;
};

interface Props {
  items: CalculatorFaqItem[];
  intro?: string;
}

const { items, intro } = Astro.props as Props;
---

<section class="mb-12 space-y-5">
  <div class="space-y-3">
    <h2>Common questions</h2>
    {intro && <p class="llc-section-copy text-ink-soft">{intro}</p>}
  </div>
  <div class="space-y-5">
    {
      items.map((item) => (
        <details class="group llc-card !p-0">
          <summary class="flex cursor-pointer items-start justify-between gap-4 px-5 py-5 text-lg font-semibold text-ink-strong sm:px-6">
            <span>{item.question}</span>
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-2 h-3.5 w-3.5 shrink-0 text-ink-muted transition group-open:rotate-180"
            >
              <path d="M4 6l4 4 4-4"></path>
            </svg>
          </summary>
          <div class="border-t border-rule px-5 py-5 sm:px-6">
            <p class="llc-section-copy text-ink-soft">{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
